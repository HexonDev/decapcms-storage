---
import BaseLayout from '../layouts/BaseLayout.astro';
import priceList from '../data/arlista.json';
const formatPrice = (price) => new Intl.NumberFormat('hu-HU').format(price);
const totalItems = priceList.categories.reduce((sum, category) => sum + category.items.length, 0);
---
<BaseLayout title="Árlista — szolgáltatások és árak">
  <header class="topbar">
    <a class="brand" href="#top" aria-label="Kezdőlap">
      <span class="brand-mark">A<span>.</span></span>
      <span class="brand-name">Árlista<span class="brand-caption">SZOLGÁLTATÁSOK · ÁRAK</span></span>
    </a>
    <nav aria-label="Fő navigáció">
      <a class="nav-link" href="#araink">Áraink</a>
      <a class="nav-cta" href="mailto:hello@example.com">Kapcsolat <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> Egyszerűen. Átláthatóan.</p>
        <h1>{priceList.title}</h1>
        <p class="intro">{priceList.intro}</p>
        <a class="hero-link" href="#araink">Megnézem az árlistát <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-art" aria-label="Absztrakt, természetes formák" role="img">
        <div class="sun"></div><div class="arch arch-back"></div><div class="arch arch-front"></div>
        <div class="art-leaf leaf-one"></div><div class="art-leaf leaf-two"></div>
        <div class="art-note"><span class="note-star">✳</span><span>Jó szolgáltatás<br />jó érzéssel indul.</span></div>
        <span class="art-index">01 / 03</span>
      </div>
      <div class="hero-foot"><span>ÁRLISTA · 2026</span><span>GÖRGESS A RÉSZLETEKHEZ <span aria-hidden="true">↓</span></span></div>
    </section>

    <section class="pricing" id="araink">
      <div class="section-heading">
        <div><p class="eyebrow"><span class="eyebrow-line"></span> A szolgáltatásaink</p><h2>Áraink</h2></div>
        <p class="section-intro">Minden, amit tudni szeretnél,<br />mielőtt belevágsz.</p>
      </div>

      <div class="price-layout">
        <aside class="price-aside">
          <span class="aside-count">0{priceList.categories.length}</span>
          <p>{priceList.note}</p>
          <a href="mailto:hello@example.com">Kérdezz bátran <span aria-hidden="true">↗</span></a>
          <div class="aside-stamp"><span>GONDOSAN<br />ÖSSZEÁLLÍTVA</span><b>✳</b></div>
        </aside>

        <div class="category-list">
          {priceList.categories.map((category, index) => (
            <section class="category">
              <div class="category-title"><span class="category-number">0{index + 1}</span><div><h3>{category.name}</h3><p>{category.description}</p></div><span class="category-symbol" aria-hidden="true">↘</span></div>
              <div class="items">
                {category.items.map((item) => (
                  <article class:list={['price-item', item.featured && 'featured']}>
                    <div class="item-main"><div class="item-name">{item.name}{item.featured && <span class="popular">NÉPSZERŰ</span>}</div><p>{item.description}</p></div>
                    <div class="item-price"><strong>{formatPrice(item.price)} <small>Ft</small></strong><span>/ {item.unit}</span></div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
      <div class="price-footer"><span>{totalItems} VÁLASZTHATÓ LEHETŐSÉG</span><span>AZ ÁRAK TARTALMAZZÁK AZ ADÓKAT</span></div>
    </section>

    <section class="contact">
      <div><p class="eyebrow"><span class="eyebrow-line"></span> Még kérdésed van?</p><h2>Beszéljük meg.</h2></div>
      <a class="contact-button" href="mailto:hello@example.com">Írj nekünk <span aria-hidden="true">↗</span></a>
      <span class="contact-flower" aria-hidden="true">✳</span>
    </section>
  </main>

  <footer><a class="footer-brand" href="#top">A<span>.</span></a><span>© 2026 · MINDEN JOG FENNTARTVA</span><a href="/admin/">CMS belépés</a></footer>
</BaseLayout>

<script>
  import '../scripts/arlista-live.js';
</script>

<style>
  :global(body) { background: #f6f4ee; }
  .topbar { height: 86px; padding: 0 7.3vw; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e9e6dc; }
  .brand { display: flex; gap: 12px; align-items: center; text-decoration: none; }
  .brand-mark, .footer-brand { font: 800 31px 'Manrope',sans-serif; letter-spacing: -3px; color: #496b5c; }
  .brand-mark span, .footer-brand span { color: #cc784f; }
  .brand-name { font: 700 13px 'Manrope',sans-serif; letter-spacing: -.3px; }
  .brand-caption { display: block; margin-top: 3px; font: 600 8px 'DM Sans',sans-serif; letter-spacing: 1.5px; color: #8b9189; }
  nav { display: flex; align-items: center; gap: 34px; font-size: 12px; font-weight: 600; }
  nav a { text-decoration: none; }.nav-link { color: #67716b; }.nav-cta { padding: 12px 17px; border: 1px solid #d9ddd5; border-radius: 3px; }.nav-cta span { color: #c36f48; margin-left: 10px; }
  .hero { min-height: 580px; padding: 75px 11vw 25px; display: grid; grid-template-columns: 1fr .8fr; column-gap: 8%; position: relative; overflow: hidden; }
  .hero-copy { align-self: center; padding-bottom: 35px; position: relative; z-index: 2; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: #7b887e; font-size: 9px; letter-spacing: 1.65px; text-transform: uppercase; font-weight: 700; }
  .eyebrow-line { width: 24px; height: 1px; display: inline-block; background: #c97855; }
  h1,h2,h3,p { margin-top: 0; }
  h1,h2,h3 { font-family: 'Manrope',sans-serif; }
  h1 { max-width: 600px; margin: 26px 0 22px; font-size: clamp(42px,5.4vw,70px); line-height: 1.08; letter-spacing: -4px; font-weight: 600; }
  .intro { max-width: 430px; color: #727c75; font-size: 14px; line-height: 1.8; }
  .hero-link { display: inline-flex; margin-top: 17px; padding-bottom: 9px; gap: 19px; border-bottom: 1px solid #aeb7ae; text-decoration: none; color: #405d50; font-size: 12px; font-weight: 700; }.hero-link span { color: #c97855; }
  .hero-art { align-self: center; height: 410px; max-width: 400px; width: 100%; position: relative; justify-self: end; background: #e7e9dd; border-radius: 48% 48% 3px 3px; overflow: hidden; }
  .sun { position: absolute; width: 138px; height: 138px; border-radius: 50%; background: #d8a17c; right: 42px; top: 54px; }
  .arch { position: absolute; bottom: -4px; border-radius: 150px 150px 0 0; }.arch-back { width: 220px; height: 284px; background: #9eae98; right: 73px; }.arch-front { width: 168px; height: 224px; background: #617e6c; right: 142px; }
  .art-leaf { position: absolute; width: 36px; height: 125px; background: #80977e; border-radius: 100% 0 100% 0; transform: rotate(32deg); }.leaf-one { left: 41px; bottom: 15px; }.leaf-two { left: 75px; bottom: 5px; transform: rotate(58deg) scale(.78); background: #a4b095; }
  .art-note { position: absolute; bottom: 31px; right: 23px; z-index: 2; display: flex; gap: 9px; align-items: center; padding: 12px 14px; background: #f6f4ee; color: #59675d; font-size: 9px; line-height: 1.5; box-shadow: 0 7px 20px #23382a12; }.note-star { color: #bf704c; font-size: 20px; }
  .art-index { position: absolute; top: 21px; left: 20px; color: #677b68; font-size: 9px; letter-spacing: 1px; }
  .hero-foot { position: absolute; bottom: 24px; left: 11vw; right: 11vw; display: flex; justify-content: space-between; color: #a1a69d; font-size: 8px; letter-spacing: 1.4px; font-weight: 700; }
  .hero-foot span span { color: #c97855; padding-left: 6px; }
  .pricing { padding: 102px 11vw 48px; background: #fffefa; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; margin-bottom: 55px; }
  h2 { margin: 12px 0 0; font-size: clamp(40px,5vw,58px); font-weight: 600; letter-spacing: -3px; }
  .section-intro { margin-bottom: 3px; color: #8a9189; font-size: 12px; line-height: 1.8; }
  .price-layout { display: grid; grid-template-columns: 220px 1fr; gap: 10%; }
  .price-aside { position: relative; padding-top: 8px; color: #7a847c; font-size: 11px; line-height: 1.8; }.aside-count { color: #cc7955; font: 500 36px 'Manrope',sans-serif; }.price-aside p { max-width: 185px; margin: 17px 0 15px; }.price-aside > a { color: #476654; text-decoration: none; font-size: 10px; font-weight: 700; border-bottom: 1px solid #ccd4ca; padding-bottom: 5px; }.price-aside > a span { color: #c97855; padding-left: 10px; }
  .aside-stamp { margin-top: 55px; width: 116px; height: 116px; border: 1px solid #d9dfd6; border-radius: 50%; display: flex; align-items: center; justify-content: center; gap: 8px; color: #829083; font-size: 7px; letter-spacing: 1px; line-height: 1.6; }.aside-stamp b { color: #c97855; font-size: 25px; font-weight: 400; }
  .category { border-top: 1px solid #e5e7df; padding: 27px 0 18px; }.category-title { display: flex; align-items: flex-start; gap: 17px; position: relative; padding-bottom: 12px; }.category-number { color: #c97855; font-size: 9px; letter-spacing: 1px; margin-top: 7px; }.category-title h3 { margin: 0 0 4px; font-size: 19px; letter-spacing: -.6px; font-weight: 700; }.category-title p { color: #9a9f96; margin: 0; font-size: 10px; }.category-symbol { position: absolute; right: 0; top: 3px; color: #bdc4b9; font-size: 16px; }
  .price-item { display: flex; justify-content: space-between; gap: 20px; align-items: center; padding: 15px 17px; border-bottom: 1px solid #f0f0ea; }.price-item.featured { background: #f7f7f1; border-radius: 3px; }.item-name { display: flex; align-items: center; gap: 9px; font-size: 12px; font-weight: 700; }.item-main p { margin: 5px 0 0; color: #969d95; font-size: 10px; line-height: 1.5; }.popular { color: #a56545; background: #f2e8dd; padding: 4px 6px; border-radius: 2px; font-size: 7px; letter-spacing: .7px; }.item-price { min-width: 105px; text-align: right; }.item-price strong { display: block; font: 700 16px 'Manrope',sans-serif; white-space: nowrap; }.item-price small { font-size: 10px; color: #69776b; }.item-price > span { color: #a0a69d; font-size: 9px; }
  .price-footer { margin-top: 40px; border-top: 1px solid #e5e7df; padding-top: 17px; display: flex; justify-content: space-between; color: #a6aba3; letter-spacing: 1px; font-size: 8px; font-weight: 700; }
  .contact { min-height: 245px; margin: 0 11vw; display: flex; align-items: center; justify-content: space-between; position: relative; overflow: hidden; }.contact h2 { font-size: clamp(36px,4vw,49px); }.contact-button { position: relative; z-index: 1; padding: 15px 21px; background: #496b5c; border-radius: 3px; color: white; font-size: 11px; text-decoration: none; }.contact-button span { color: #e4b18e; margin-left: 22px; }.contact-flower { position: absolute; right: 16%; bottom: -66px; font-size: 170px; color: #eceee5; }
  footer { min-height: 77px; padding: 0 7.3vw; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #e9e6dc; color: #a0a69e; font-size: 8px; letter-spacing: 1px; }.footer-brand { font-size: 23px; text-decoration: none; }
  @media (max-width: 750px) { .topbar { height: 70px; padding: 0 6vw; }.nav-link { display:none; }.hero { padding: 57px 7vw 65px; grid-template-columns: 1fr; row-gap: 25px; }.hero-copy { padding-bottom: 0; }.hero-art { justify-self: center; height: 350px; max-width: 360px; }.hero-foot { left: 7vw; right: 7vw; }.hero-foot span:last-child { display: none; }.pricing { padding: 72px 7vw 35px; }.section-heading { margin-bottom: 35px; }.section-intro { display: none; }.price-layout { grid-template-columns: 1fr; gap: 35px; }.price-aside { display: flex; align-items: center; gap: 13px; }.price-aside p { margin: 0; max-width: 240px; }.price-aside > a,.aside-stamp { display:none; }.aside-count { font-size: 28px; }.price-footer { margin-top: 27px; gap: 16px; font-size: 7px; }.contact { margin: 0 7vw; min-height: 220px; }.contact-flower { right: 10%; font-size: 120px; bottom: -45px; } footer { padding: 0 6vw; } }
  @media (max-width: 430px) { h1 { letter-spacing: -2.5px; }.category-title h3 { font-size: 17px; }.price-item { padding: 13px 8px; gap: 10px; }.item-price { min-width: 88px; }.item-price strong { font-size: 14px; }.item-main p { max-width: 200px; }.popular { display:none; }.contact { gap: 20px; }.contact-button { padding: 13px 14px; white-space: nowrap; }.price-footer { flex-direction: column; } }
</style>
